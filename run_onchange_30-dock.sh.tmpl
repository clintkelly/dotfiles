#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}

if ! command -v dockutil >/dev/null 2>&1; then
  echo "dockutil not found; skipping Dock setup"
  exit 0
fi

dockutil --remove all --no-restart || true

dockutil --add "/Applications/Google Chrome.app" --no-restart || true
dockutil --add "/Applications/Visual Studio Code.app" --no-restart || true
dockutil --add "/Applications/Cursor.app" --no-restart || true
dockutil --add "/Applications/iTerm.app" --no-restart || true
dockutil --add "/System/Applications/System Settings.app" --no-restart || true
dockutil --add "$HOME/Downloads" --view fan --display stack --sort dateadded --no-restart || true

killall Dock || true

{{- end }}
